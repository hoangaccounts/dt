#!/usr/bin/env bash
# data/git-detector - Detect git repository
#
# Responsibility: Interact with git to detect repository root
# Dependencies: ui/output

detect_git_repo_root() {
  local path="${1:-.}"
  
  # Try to get git root
  local repo_root
  if repo_root=$(cd "$path" && git rev-parse --show-toplevel 2>/dev/null); then
    echo "$repo_root"
    return 0
  fi
  
  return 1
}

validate_is_git_repo() {
  local path=$1
  
  if [[ ! -d "$path/.git" ]]; then
    return 1
  fi
  
  return 0
}

get_github_remote_url() {
  local repo_root=$1
  
  # Try to get origin remote URL
  local remote_url
  if remote_url=$(cd "$repo_root" && git remote get-url origin 2>/dev/null); then
    echo "$remote_url"
    return 0
  fi
  
  return 1
}

extract_github_repo_from_url() {
  local url=$1
  
  # Extract owner/repo from various GitHub URL formats
  # https://github.com/owner/repo.git
  # git@github.com:owner/repo.git
  # https://github.com/owner/repo
  
  local repo
  if [[ "$url" =~ github\.com[:/]([^/]+/[^/]+)(\.git)?$ ]]; then
    repo="${BASH_REMATCH[1]}"
    # Remove .git suffix if present
    repo="${repo%.git}"
    echo "$repo"
    return 0
  fi
  
  return 1
}

get_github_repo_path() {
  local repo_root=$1
  
  local remote_url
  if ! remote_url=$(get_github_remote_url "$repo_root"); then
    return 1
  fi
  
  extract_github_repo_from_url "$remote_url"
}
