#!/usr/bin/env bash
# ui/guided-checklist - Post-install guided setup
#
# Responsibility: Guide user through manual GitHub configuration
# Dependencies: ui/output, ui/input, data/git-detector

show_guided_checklist() {
  local repo_root=$1
  local project_key=$2
  
  echo ""
  echo "════════════════════════════════════════"
  echo "  Post-Install Configuration"
  echo "════════════════════════════════════════"
  echo ""
  print_info "The baseline files are installed. Complete these manual steps:"
  echo ""
  
  # Try to get GitHub repo path
  local github_repo
  if github_repo=$(get_github_repo_path "$repo_root"); then
    show_push_baseline_step_with_url "$github_repo"
    show_branch_protection_step_with_url "$github_repo" "$project_key"
    echo ""
    show_labels_step_with_url "$github_repo"
  else
    show_push_baseline_step_generic
    show_branch_protection_step_generic "$project_key"
    echo ""
    show_labels_step_generic
  fi
  
  echo ""
  print_success "Setup complete!"
  echo ""
  print_info "Next steps:"
  echo "  1. Create your first issue"
  echo "  2. Make changes in a feature branch"
  echo "  3. Open a PR following the template"
  echo ""
}

show_push_baseline_step_with_url() {
  local github_repo=$1

  echo "──────────────────────────────────────────"
  echo "Step 1/3: Push Baseline to GitHub"
  echo "──────────────────────────────────────────"
  echo ""
  echo "Why: GitHub must run the workflows at least once before the required status checks"
  echo "     appear in Branch Protection settings."
  echo ""
  echo "Instructions:"
  echo "  1. Commit the installed baseline files"
  echo "  2. Push to GitHub (typically to main once, before Branch Protection is enabled)"
  echo "  3. Wait for Actions to finish at least once"
  echo "  4. Confirm checks exist at: https://github.com/${github_repo}/actions"
  echo ""

  if prompt_yes_no "Complete" "n"; then
    print_success "Baseline pushed and Actions ran"
  else
    print_info "Complete this step before configuring Branch Protection"
  fi
}

