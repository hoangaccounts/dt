show_branch_protection_step_with_url() {
  local github_repo=$1
  local project_key=$2
  
  echo "──────────────────────────────────────────"
  echo "Step 2/3: Enable Branch Protection"
  echo "──────────────────────────────────────────"
  echo ""
  echo "Instructions:"
  echo "  1. Go to: https://github.com/${github_repo}/settings/branches"
  echo "  2. Click 'Add rule' or 'Add branch protection rule'"
  echo "  3. Branch name pattern: main"
  echo "  4. Check ☑ 'Require a pull request before merging'"
  echo "  5. Check ☑ 'Require status checks to pass before merging'"
  echo "  6. Search for and add these status checks:"
  echo "     • ci"
  echo "     • traceability/pr-title"
  echo "     • traceability/commit-subjects"
  echo "     • traceability/type-label"
  echo "     • traceability/issue-link"
  echo "  7. (Optional) Check ☑ 'Require approvals' and set to 1"
  echo "  8. Click 'Create' or 'Save changes'"
  echo ""
  
  if prompt_yes_no "Complete" "n"; then
    print_success "Branch protection configured"
  else
    print_info "Remember to complete this step later"
  fi
}

