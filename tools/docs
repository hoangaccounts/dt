#!/usr/bin/env bash
# VERSION: 0.0.2
# SUMMARY: Install the standard docs pack into a target project.
# TAGS: project, files
# SYNOPSIS: dt docs
#   dt docs init [--dest PATH] [--project-name NAME] [--project-prefix PREFIX] [--dry-run] [--force] [--yes]
# SAFETY: confirm
# DESCRIPTION: Installs the committed docs standard pack from templates/docs-standard/v1
#   into the selected destination directory. The pack includes repo-root AGENT.md,
#   canonical lanes, and a draft-first docs/05-working scaffold. Existing files are
#   skipped by default; --force overwrites template-owned file collisions. The default
#   destination is the current directory.
# OPTIONS:
#   --dest <path>             Install into this directory instead of the current directory
#   --project-name <name>     Replace {{PROJECT_NAME}} placeholders with this value
#   --project-prefix <prefix> Replace {{PROJECT_PREFIX}} placeholders with this value
#   --force                   Overwrite template-owned file collisions deterministically
#   --dry-run                 Print the install plan without writing files or prompting
#   --yes                     Skip interactive confirmation and defer prefix prompts
#   -h, --help, help          Show this help
# EXAMPLES:
#   dt docs
#   dt docs init
#   dt docs init --dry-run
#   dt docs init --dest ./sandbox --project-name "Sandbox" --project-prefix sbx --yes
#   dt docs init --force --yes
# OUTPUT: Writes AGENT.md plus a docs/ tree into the target project and prints created/skipped/overwritten summaries.
# DEPS: find, grep, head, mkdir, mv, sed, sort
# MISC: Token replacement is intentionally narrow and only supports {{PROJECT_NAME}} and {{PROJECT_PREFIX}}.
### END HELP
set -euo pipefail

readonly TOOL_ID="docs"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly TEMPLATE_VERSION="docs-standard/v1"
readonly TEMPLATE_ROOT="${REPO_ROOT}/templates/${TEMPLATE_VERSION}"
readonly TRACEABILITY_PATH=".github/workflows/traceability.yml"

RESOLVED_PROJECT_PREFIX=""
PROJECT_PREFIX_MODE="deferred"
PROJECT_PREFIX_CANDIDATE=""

main() {
  local subcommand="${1:-}"
  shift || true

  case "${subcommand}" in
    ""|-h|--help|help)
      print_help
      ;;
    init)
      cmd_init "$@"
      ;;
    install|uninstall|status)
      echo "Not supported: dt ${TOOL_ID} ${subcommand}" >&2
      print_usage >&2
      exit 2
      ;;
    *)
      echo "Unknown subcommand: ${subcommand}" >&2
      print_usage >&2
      exit 2
      ;;
  esac
}

print_help() {
  awk '
    NR==1 && $0 ~ /^#!/ { next }
    $0 ~ /^### END HELP$/ { exit }
    $0 ~ /^# / { sub(/^# /, "", $0); print; next }
    $0 ~ /^#$/ { print ""; next }
  ' "$0"
}

print_usage() {
  echo "Usage: dt docs init [--dest PATH] [--project-name NAME] [--project-prefix PREFIX] [--dry-run] [--force] [--yes]"
  echo "Run: dt help docs"
}

fail_usage() {
  echo "${1}" >&2
  print_usage >&2
  exit 2
}

require_template_pack() {
  if [[ ! -d "${TEMPLATE_ROOT}" ]]; then
    echo "Missing template pack: ${TEMPLATE_ROOT}" >&2
    exit 2
  fi

  if [[ ! -f "${TEMPLATE_ROOT}/AGENT.md" ]]; then
    echo "Missing template file: ${TEMPLATE_ROOT}/AGENT.md" >&2
    exit 2
  fi

  if [[ ! -d "${TEMPLATE_ROOT}/docs" ]]; then
    echo "Missing template directory: ${TEMPLATE_ROOT}/docs" >&2
    exit 2
  fi
}

require_flag_value() {
  local flag_name="${1}"
  local flag_value="${2:-}"

  if [[ -z "${flag_value}" || "${flag_value}" == -* ]]; then
    fail_usage "Missing value for ${flag_name}"
  fi
}

make_temp_file() {
  mktemp 2>/dev/null || mktemp -t "dt-docs-plan"
}

resolve_target_path() {
  local input_path="${1}"

  if [[ "${input_path}" == "." ]]; then
    pwd -P
    return 0
  fi

  if [[ "${input_path}" == /* ]]; then
    if [[ -d "${input_path}" ]]; then
      (
        cd "${input_path}" &&
          pwd -P
      )
    else
      printf '%s\n' "${input_path}"
    fi
    return 0
  fi

  if [[ -d "${input_path}" ]]; then
    (
      cd "${input_path}" &&
        pwd -P
    )
  else
    printf '%s/%s\n' "$(pwd -P)" "${input_path}"
  fi
}

derive_project_name() {
  local target_path="${1}"
  local base_name=""
  local normalized_name=""

  base_name="$(basename "${target_path}")"
  if [[ -z "${base_name}" || "${base_name}" == "/" || "${base_name}" == "." ]]; then
    base_name="project"
  fi

  normalized_name="$(printf '%s\n' "${base_name}" | tr '_-' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//')"
  if [[ -z "${normalized_name}" ]]; then
    normalized_name="Project"
  fi

  printf '%s\n' "${normalized_name}" | awk '
    {
      for (i = 1; i <= NF; i++) {
        first = substr($i, 1, 1)
        rest = substr($i, 2)
        $i = toupper(first) tolower(rest)
      }
      print
    }
  '
}

escape_sed_replacement() {
  local raw_value="${1}"

  raw_value="${raw_value//\\/\\\\}"
  raw_value="${raw_value//&/\\&}"
  raw_value="${raw_value//|/\\|}"

  printf '%s' "${raw_value}"
}

count_plan_action() {
  local plan_file="${1}"
  local action_name="${2}"

  awk -F '\t' -v action="${action_name}" '
    $1 == action { count++ }
    END { print count + 0 }
  ' "${plan_file}"
}

lookup_plan_action() {
  local plan_file="${1}"
  local relative_path="${2}"

  awk -F '\t' -v path="${relative_path}" '
    $4 == path { print $1; exit }
  ' "${plan_file}"
}

render_template_string() {
  local template_value="${1}"
  local project_name="${2}"
  local project_prefix="${3}"

  template_value="${template_value//'{{PROJECT_NAME}}'/${project_name}}"
  template_value="${template_value//'{{PROJECT_PREFIX}}'/${project_prefix}}"

  printf '%s\n' "${template_value}"
}

validate_project_prefix() {
  local project_prefix="${1}"

  if [[ "${project_prefix}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    return 0
  fi

  return 1
}

prompt_for_text() {
  local prompt_text="${1}"
  local value=""

  printf '%s: ' "${prompt_text}" >&2
  IFS= read -r value || true

  printf '%s\n' "${value}"
}

prompt_yes_no_default_no() {
  local prompt_text="${1}"
  local answer=""

  printf '%s [y/N]: ' "${prompt_text}" >&2
  IFS= read -r answer || true
  case "${answer}" in
    y|Y|yes|YES)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

confirm_write() {
  if prompt_yes_no_default_no "Proceed with docs install?"; then
    return 0
  fi

  echo "Canceled."
  return 1
}

detect_existing_project_key() {
  local target_root="${1}"
  local traceability_file="${target_root%/}/${TRACEABILITY_PATH}"
  local detected_key=""

  if [[ ! -f "${traceability_file}" ]]; then
    return 1
  fi

  detected_key="$(grep -oE '[A-Z][A-Z0-9]{1,9}-[0-9]+' "${traceability_file}" | head -1 | cut -d- -f1 || true)"
  if [[ -z "${detected_key}" ]]; then
    return 1
  fi

  printf '%s\n' "${detected_key}"
}

detect_project_prefix_candidate() {
  local target_root="${1}"
  local existing_key=""

  existing_key="$(detect_existing_project_key "${target_root}" || true)"
  if [[ -z "${existing_key}" ]]; then
    return 1
  fi

  printf '%s\n' "${existing_key}" | tr '[:upper:]' '[:lower:]'
}

resolve_project_prefix() {
  local target_root="${1}"
  local requested_prefix="${2}"
  local dry_run="${3}"
  local yes_mode="${4}"
  local prompted_prefix=""

  RESOLVED_PROJECT_PREFIX=""
  PROJECT_PREFIX_MODE="deferred"
  PROJECT_PREFIX_CANDIDATE="$(detect_project_prefix_candidate "${target_root}" || true)"

  if [[ -n "${requested_prefix}" ]]; then
    if ! validate_project_prefix "${requested_prefix}"; then
      fail_usage "Invalid value for --project-prefix: ${requested_prefix}"
    fi

    RESOLVED_PROJECT_PREFIX="${requested_prefix}"
    PROJECT_PREFIX_MODE="provided"
    return 0
  fi

  if [[ "${dry_run}" == "true" || "${yes_mode}" == "true" ]]; then
    PROJECT_PREFIX_MODE="deferred"
    return 0
  fi

  if [[ -n "${PROJECT_PREFIX_CANDIDATE}" ]]; then
    echo "Detected project prefix candidate from repo-baseline: ${PROJECT_PREFIX_CANDIDATE}" >&2
    if prompt_yes_no_default_no "Use detected project prefix?"; then
      RESOLVED_PROJECT_PREFIX="${PROJECT_PREFIX_CANDIDATE}"
      PROJECT_PREFIX_MODE="inferred"
      return 0
    fi
  fi

  while true; do
    prompted_prefix="$(prompt_for_text "Project prefix (lowercase letters, numbers, hyphens; leave blank to defer)")"
    if [[ -z "${prompted_prefix}" ]]; then
      PROJECT_PREFIX_MODE="deferred"
      return 0
    fi

    if validate_project_prefix "${prompted_prefix}"; then
      RESOLVED_PROJECT_PREFIX="${prompted_prefix}"
      PROJECT_PREFIX_MODE="prompted"
      return 0
    fi

    echo "Invalid project prefix. Use lowercase letters, numbers, and hyphens only." >&2
  done
}

build_plan() {
  local target_root="${1}"
  local force_mode="${2}"
  local plan_file="${3}"
  local project_name="${4}"
  local project_prefix="${5}"
  local source_path=""
  local template_relative_path=""
  local rendered_relative_path=""
  local destination_path=""
  local action=""

  : >"${plan_file}"

  while IFS= read -r source_path; do
    template_relative_path="${source_path#"${TEMPLATE_ROOT}/"}"
    rendered_relative_path="$(render_template_string "${template_relative_path}" "${project_name}" "${project_prefix}")"

    if [[ "${target_root}" == "/" ]]; then
      destination_path="/${rendered_relative_path}"
    else
      destination_path="${target_root%/}/${rendered_relative_path}"
    fi

    if [[ -d "${destination_path}" ]]; then
      action="skip"
    elif [[ -e "${destination_path}" || -L "${destination_path}" ]]; then
      if [[ "${force_mode}" == "true" ]]; then
        action="overwrite"
      else
        action="skip"
      fi
    else
      action="create"
    fi

    printf '%s\t%s\t%s\t%s\n' "${action}" "${source_path}" "${destination_path}" "${rendered_relative_path}"
  done >"${plan_file}" < <(
    find "${TEMPLATE_ROOT}" -type f \
      ! -name '.DS_Store' \
      ! -name '._*' | LC_ALL=C sort
  )
}

print_project_prefix_line() {
  local resolved_prefix="${1}"
  local prefix_mode="${2}"
  local candidate="${3}"

  case "${prefix_mode}" in
    provided)
      echo "Project prefix: ${resolved_prefix}"
      ;;
    inferred)
      echo "Project prefix: ${resolved_prefix} (confirmed from repo-baseline)"
      ;;
    prompted)
      echo "Project prefix: ${resolved_prefix}"
      ;;
    *)
      echo "Project prefix: deferred ({{PROJECT_PREFIX}} retained)"
      if [[ -n "${candidate}" ]]; then
        echo "Project prefix candidate: ${candidate} (detected from repo-baseline; not applied)"
      fi
      ;;
  esac
}

print_plan() {
  local plan_file="${1}"
  local target_root="${2}"
  local project_name="${3}"
  local project_prefix="${4}"
  local prefix_mode="${5}"
  local prefix_candidate="${6}"
  local dry_run="${7}"
  local create_count=""
  local skip_count=""
  local overwrite_count=""
  local action=""
  local relative_path=""
  local label=""
  local agent_action=""

  create_count="$(count_plan_action "${plan_file}" "create")"
  skip_count="$(count_plan_action "${plan_file}" "skip")"
  overwrite_count="$(count_plan_action "${plan_file}" "overwrite")"
  agent_action="$(lookup_plan_action "${plan_file}" "AGENT.md" || true)"

  echo "Target: ${target_root}"
  echo "Template: ${TEMPLATE_VERSION}"
  echo "Project name: ${project_name}"
  print_project_prefix_line "${project_prefix}" "${prefix_mode}" "${prefix_candidate}"
  if [[ "${dry_run}" == "true" ]]; then
    echo "Mode: dry-run"
  fi

  echo ""
  echo "Plan:"

  while IFS=$'\t' read -r action _ _ relative_path; do
    case "${action}" in
      create)
        label="create"
        ;;
      skip)
        label="skip"
        ;;
      overwrite)
        label="overwrite"
        ;;
      *)
        label="${action}"
        ;;
    esac

    if [[ "${dry_run}" == "true" ]]; then
      label="would ${label}"
    fi

    echo "  ${label}: ${relative_path}"
  done <"${plan_file}"

  echo ""
  echo "Summary:"
  if [[ -n "${agent_action}" ]]; then
    echo "  AGENT.md: ${agent_action}"
  fi
  echo "  create: ${create_count}"
  echo "  skip: ${skip_count}"
  echo "  overwrite: ${overwrite_count}"
}

print_result_summary() {
  local target_root="${1}"
  local create_count="${2}"
  local skip_count="${3}"
  local overwrite_count="${4}"
  local project_prefix="${5}"
  local prefix_mode="${6}"
  local prefix_candidate="${7}"
  local plan_file="${8}"
  local agent_action=""

  agent_action="$(lookup_plan_action "${plan_file}" "AGENT.md" || true)"

  echo "Result:"
  if [[ -n "${agent_action}" ]]; then
    case "${agent_action}" in
      create)
        echo "  AGENT.md: created"
        ;;
      overwrite)
        echo "  AGENT.md: overwritten"
        ;;
      skip)
        echo "  AGENT.md: skipped"
        ;;
    esac
  fi
  echo "  created: ${create_count}"
  echo "  skipped: ${skip_count}"
  echo "  overwritten: ${overwrite_count}"
  echo "  target: ${target_root}"
  echo "  template: ${TEMPLATE_VERSION}"
  case "${prefix_mode}" in
    provided|prompted)
      echo "  project prefix: ${project_prefix}"
      ;;
    inferred)
      echo "  project prefix: ${project_prefix} (confirmed from repo-baseline)"
      ;;
    *)
      echo "  project prefix: deferred"
      if [[ -n "${prefix_candidate}" ]]; then
        echo "  project prefix candidate: ${prefix_candidate}"
      fi
      ;;
  esac
}

write_template_file() {
  local source_path="${1}"
  local destination_path="${2}"
  local project_name="${3}"
  local project_prefix="${4}"
  local escaped_project_name=""
  local escaped_project_prefix=""
  local temp_path=""

  escaped_project_name="$(escape_sed_replacement "${project_name}")"
  escaped_project_prefix="$(escape_sed_replacement "${project_prefix}")"
  temp_path="${destination_path}.dt-docs-tmp.$$"

  mkdir -p "$(dirname "${destination_path}")"

  if ! LC_ALL=C sed \
    -e "s|{{PROJECT_NAME}}|${escaped_project_name}|g" \
    -e "s|{{PROJECT_PREFIX}}|${escaped_project_prefix}|g" \
    "${source_path}" >"${temp_path}"; then
    rm -f "${temp_path}"
    return 1
  fi

  mv "${temp_path}" "${destination_path}"
}

execute_plan() {
  local plan_file="${1}"
  local project_name="${2}"
  local project_prefix="${3}"
  local action=""
  local source_path=""
  local destination_path=""

  while IFS=$'\t' read -r action source_path destination_path _; do
    case "${action}" in
      create|overwrite)
        write_template_file "${source_path}" "${destination_path}" "${project_name}" "${project_prefix}"
        ;;
      skip)
        ;;
      *)
        echo "Unknown plan action: ${action}" >&2
        exit 2
        ;;
    esac
  done <"${plan_file}"
}

cmd_init() {
  local destination="."
  local project_name=""
  local requested_project_prefix=""
  local project_prefix_token="{{PROJECT_PREFIX}}"
  local dry_run="false"
  local force_mode="false"
  local yes_mode="false"
  local target_root=""
  local plan_file=""
  local create_count=""
  local skip_count=""
  local overwrite_count=""
  local write_count=0

  while [[ "${#}" -gt 0 ]]; do
    case "${1}" in
      --dest)
        require_flag_value "${1}" "${2:-}"
        destination="${2}"
        shift 2
        ;;
      --project-name)
        require_flag_value "${1}" "${2:-}"
        project_name="${2}"
        shift 2
        ;;
      --project-prefix)
        require_flag_value "${1}" "${2:-}"
        requested_project_prefix="${2}"
        shift 2
        ;;
      --force)
        force_mode="true"
        shift
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      --yes)
        yes_mode="true"
        shift
        ;;
      -h|--help|help)
        print_help
        return 0
        ;;
      *)
        fail_usage "Unknown argument: ${1}"
        ;;
    esac
  done

  require_template_pack

  target_root="$(resolve_target_path "${destination}")"
  if [[ -e "${target_root}" && ! -d "${target_root}" ]]; then
    echo "Destination is not a directory: ${target_root}" >&2
    exit 2
  fi

  if [[ -z "${project_name}" ]]; then
    project_name="$(derive_project_name "${target_root}")"
  fi

  resolve_project_prefix "${target_root}" "${requested_project_prefix}" "${dry_run}" "${yes_mode}"
  if [[ -n "${RESOLVED_PROJECT_PREFIX}" ]]; then
    project_prefix_token="${RESOLVED_PROJECT_PREFIX}"
  fi

  plan_file="$(make_temp_file)"
  trap "rm -f '${plan_file}'" EXIT

  build_plan "${target_root}" "${force_mode}" "${plan_file}" "${project_name}" "${project_prefix_token}"

  if [[ ! -s "${plan_file}" ]]; then
    echo "Template pack is empty: ${TEMPLATE_ROOT}" >&2
    exit 2
  fi

  create_count="$(count_plan_action "${plan_file}" "create")"
  skip_count="$(count_plan_action "${plan_file}" "skip")"
  overwrite_count="$(count_plan_action "${plan_file}" "overwrite")"
  write_count=$((create_count + overwrite_count))

  print_plan "${plan_file}" "${target_root}" "${project_name}" "${project_prefix_token}" "${PROJECT_PREFIX_MODE}" "${PROJECT_PREFIX_CANDIDATE}" "${dry_run}"

  if [[ "${dry_run}" == "true" ]]; then
    echo ""
    echo "Dry run only. No files were written."
    return 0
  fi

  if [[ "${write_count}" -gt 0 && "${yes_mode}" != "true" ]]; then
    echo ""
    if ! confirm_write; then
      return 0
    fi
  fi

  if [[ "${write_count}" -gt 0 ]]; then
    execute_plan "${plan_file}" "${project_name}" "${project_prefix_token}"
  else
    echo ""
    echo "No writes were needed."
  fi

  echo ""
  print_result_summary "${target_root}" "${create_count}" "${skip_count}" "${overwrite_count}" "${project_prefix_token}" "${PROJECT_PREFIX_MODE}" "${PROJECT_PREFIX_CANDIDATE}" "${plan_file}"
}

main "$@"
